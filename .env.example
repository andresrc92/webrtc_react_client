# ---------------------------------------------------------------------------
# Vite dev server (npm run dev) — connects straight to Isaac Sim on your LAN
# ---------------------------------------------------------------------------

# IP or hostname of the machine running Isaac Sim in streaming mode.
VITE_ISAAC_SIM_SERVER=

# Defaults match Isaac Sim 5.0.1's omni.kit.livestream.webrtc extension.
# Confirm against the actual startup log if these were overridden.
VITE_ISAAC_SIM_SIGNAL_PORT=49100
VITE_ISAAC_SIM_MEDIA_PORT=47998

VITE_STREAM_WIDTH=1280
VITE_STREAM_HEIGHT=720
VITE_STREAM_FPS=30

# Auto-reconnect attempts on a connection wobble. The streaming library
# defaults to 5, but Isaac Sim's livestream is SINGLE-SESSION: each reconnect
# makes it re-init its capture device, which a held encoder can't do — that
# wedges the stream for ALL clients (`thread_init: already added for thread`,
# recover by restarting the sim). Default 0 = one clean attempt, no re-init.
VITE_MAX_RECONNECTS=0

# Only needed when going through the Caddy reverse proxy (remote/internet
# deployment, see docker-compose.yml). Leave unset for direct LAN access.
# VITE_SIGNALING_SERVER=your-public-domain-or-ip
# VITE_SIGNALING_PATH=/ws/signaling
# VITE_FORCE_WSS=true

# ---------------------------------------------------------------------------
# docker-compose (remote/internet demo deployment)
# ---------------------------------------------------------------------------

# Public hostname/IP this deployment will be reached at (used for Caddy's
# auto-HTTPS cert and as the coturn TURN realm).
PUBLIC_HOSTNAME=

# LAN/public IP of the box running Isaac Sim (Caddy proxies signaling to it).
ISAAC_SIM_HOST=
ISAAC_SIGNAL_PORT=49100
ISAAC_MEDIA_PORT=47998

# Static-auth credentials for the coturn TURN relay.
TURN_USERNAME=
TURN_PASSWORD=
